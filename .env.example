# =============================================================================
# PlumA v0.7.0 — .env.example
# -----------------------------------------------------------------------------
# Copia este fichero a .env y ajusta solo lo necesario.
#
# Criterio general de rendimiento:
#   1. PDF con texto/capa OCR suficiente -> usar texto directamente.
#   2. PDF escaneado o imagen -> OCR local con Tesseract.
#   3. OCR insuficiente -> visión multimodal como fallback.
#
# Criterio general de seguridad:
#   - PlumA se publica solo en 127.0.0.1.
#   - Ollama debe ser local.
#   - No habilitar acceso remoto salvo revisión explícita de seguridad.
# =============================================================================

# -----------------------------------------------------------------------------
# Puerto e integración local con Ollama
# -----------------------------------------------------------------------------
# En la release local bloqueada el instalador puede gestionar estos valores.
# Se documentan aquí para auditoría y para instalaciones manuales controladas.
PUERTO=8082
PLUMA_OLLAMA_MODE=host
PLUMA_OLLAMA_URL=http://host.docker.internal:11434
PLUMA_STRICT_LOCAL=true
ALLOW_REMOTE_OLLAMA=false
ALLOW_NETWORK_EXPOSURE=false

# -----------------------------------------------------------------------------
# Modelos
# -----------------------------------------------------------------------------
# Modelo textual por defecto. Recomendado para PDFs con texto, PDFs ya OCRizados
# y documentos que el OCR local haya convertido correctamente a texto.
MODELO_BASE=gemma4:e2b

# Orden de preferencia para tareas textuales.
# Mantén primero el modelo más rápido y suficiente para extracción documental.
PLUMA_MODELOS_PREFERIDOS=gemma4:e2b,qwen3.5:latest

# Orden de preferencia para documentos con imagen o visión.
# qwen3.5:latest se ha mostrado funcional para visión en el entorno probado.
PLUMA_MODELOS_VISUALES_PREFERIDOS=qwen3.5:latest,qwen3-vl:8b,qwen3-vl:4b,qwen2.5vl:7b,qwen2.5vl:3b,gemma4:e2b

# Modelo usado en la lectura visual previa si el OCR/texto no bastan.
MODELO_VISUAL_LECTURA=qwen3.5:latest

# -----------------------------------------------------------------------------
# Inferencia Ollama
# -----------------------------------------------------------------------------
# Contextos grandes aumentan latencia y memoria. 4096 es un perfil razonable
# para uso local con documentos medianos y extracción archivística.
OLLAMA_NUM_CTX=4096

# Reducir tokens máximos evita respuestas excesivamente largas y bloqueos.
OLLAMA_NUM_PREDICT=3000

# Mantener modelos cargados evita pagar la carga inicial en cada documento.
# Aumentar consume más RAM/VRAM; reducir libera memoria antes.
OLLAMA_KEEP_ALIVE=30m

# -----------------------------------------------------------------------------
# Visión multimodal
# -----------------------------------------------------------------------------
# La visión local es costosa: úsala como fallback, no como vía principal cuando
# el PDF ya tenga texto o el OCR local funcione.
OLLAMA_VISION_TIMEOUT_SECONDS=240
OLLAMA_VISION_NUM_CTX=2048
OLLAMA_VISION_NUM_PREDICT=180
PLUMA_VISION_MAX_LONG_EDGE=900
PLUMA_VISION_JPEG_QUALITY=65
MAX_IMAGENES_LECTURA_VISUAL=4
MAX_TRANSCRIPCION_VISUAL=6000

# No analizar imágenes de PDFs híbridos si ya hay texto suficiente.
PLUMA_HIBRIDO_USAR_VISION=false
PLUMA_PDF_HIBRIDO_CON_IMAGENES=false

# Activar fallback visual cuando OCR/texto sean insuficientes.
PLUMA_LECTURA_VISUAL_PREVIA=true

# -----------------------------------------------------------------------------
# OCR local
# -----------------------------------------------------------------------------
# Incluido desde PlumA v0.7.0. Tesseract usa CPU, no GPU. Por eso se limitan
# páginas/imágenes y timeout. Para manuscritos puede ser insuficiente; en ese
# caso PlumA puede recurrir al modelo visual configurado arriba.
PLUMA_OCR_LOCAL=true
PLUMA_OCR_LANG=spa+eng
PLUMA_OCR_PSM=6
PLUMA_OCR_TIMEOUT_SEGUNDOS=30
PLUMA_OCR_MAX_IMAGENES=6
PLUMA_OCR_MIN_CARACTERES=120
PLUMA_OCR_MIN_ALFANUM_RATIO=0.35

# -----------------------------------------------------------------------------
# Límites de procesamiento
# -----------------------------------------------------------------------------
MAX_LONGITUD_TEXTO_EXTRAIDO=500000
MAX_PROCESAMIENTOS_SIMULTANEOS=1
MAX_DESCRIBIR_FILES=10
MAX_DESCRIBIR_TOTAL_BYTES=157286400

# -----------------------------------------------------------------------------
# Auditoría y UI
# -----------------------------------------------------------------------------
PERMITIR_APAGADO_UI=false
INCLUIR_HASH_DOCUMENTO_AUDITORIA=true

# -----------------------------------------------------------------------------
# Sandbox de parsers
# -----------------------------------------------------------------------------
# No desactivar en producción. Reduce impacto de entradas PDF/DOCX/imagen
# malformadas o no confiables.
USAR_SANDBOX_PARSERS=true
SANDBOX_TIMEOUT_SEGUNDOS=120
SANDBOX_MEMORIA_MB=1536
